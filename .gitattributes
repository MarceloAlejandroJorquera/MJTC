# Normalize text files while retaining Windows-native script/source line endings.
* text=auto

*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf

*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets
*.exe binary
*.dll binary
*.pdb binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary
*.mmdb binary
*.br binary
*.bin binary
*.zip binary
